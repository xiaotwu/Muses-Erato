<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.xiaotwu.muses.erato</string>
	</array>
	<!-- CarPlay Audio: turn this capability on for the App ID in Apple Developer.
	     Simulator still attaches the scene; a device build without the capability
	     will fail to sign. The iPhone UI does not depend on this key. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
